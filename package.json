{
  "name": "stellardash",
  "version": "1.1.0",
  "description": "A local-first Stellar wallet dashboard — view balances, transaction history, manage trustlines, and send payments, all from the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "gh-pages": "^6.1.1"
  }
}
